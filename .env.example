# ==============================================================================
# TraceVASP Configuration Environment Variables Template
# Copy this file to .env: cp .env.example .env
# ==============================================================================

# Application Settings
PROJECT_NAME="TraceVASP"
ENVIRONMENT="production"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Frontend API Base URL (Leave empty or /api for same-domain single proxy deployment)
VITE_API_URL=/api

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./tracevasp.db
# Docker / Production PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tracevasp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tracevasp

# JWT Authentication (Change this to a strong random string in production!)
JWT_SECRET=demo-secret-key-tracevasp-investigator-auth-sih2026-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Configuration (Comma-separated list or * for all)
CORS_ORIGINS=*

# Blockchain Intelligence API Keys (Optional - fallback to deterministic demo dataset if omitted)
ETHEREUM_API_KEY=
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
BITCOIN_API_KEY=
BNB_API_KEY=
POLYGON_API_KEY=
TRON_API_KEY=
SOLANA_RPC_URL=

# SAHYOG Adapter Configuration (Indian Cybercrime Coordination Centre simulation)
SAHYOG_MOCK_MODE=true
SAHYOG_API_ENDPOINT=https://sahyog.gov.in/api/v1
SAHYOG_API_KEY=

# Report Storage Path
REPORT_DIR=./reports
